# =============================================================================
# .env.example - Módulo 19: Seguridad y mantenimiento
# =============================================================================
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas .env al repositorio (ya está en .gitignore).
#
# Generar SECRET_KEY seguro:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# ------------------------------------------------------------------
# API y servidor
# ------------------------------------------------------------------
APP_NAME="Order Management API"
APP_VERSION="0.1.0"
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------------------
# Seguridad — JWT
# IMPORTANTE: cambia SECRET_KEY antes de desplegar a producción
# ------------------------------------------------------------------
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-32-CHARS-MINIMUM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------
# Base de datos
# SQLite (desarrollo):
#   DATABASE_URL=sqlite:///order_management.db
# PostgreSQL (producción):
#   DATABASE_URL=postgresql://user:password@localhost:5432/orders_db
# ------------------------------------------------------------------
DATABASE_URL=sqlite:///order_management.db
DB_ECHO=false

# ------------------------------------------------------------------
# CORS — separar múltiples orígenes con comas
# En producción: lista explícita de dominios permitidos
# ------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ------------------------------------------------------------------
# Notificaciones (opcional)
# ------------------------------------------------------------------
# NOTIFICATION_URL=http://localhost:8080
# NOTIFICATION_TIMEOUT=3.0
